{
    "fileVersion": 1,
    "id": "aslm-chat",
    "name": "ASLM Chat",
    "description": "ASLM Chat 模組",
    "version": "0.7.1.8",
    "author": "NGGT-ASLM",
    "type": "ui",
    "category": [
        "text-generation"
    ],
    "hasPage": true,
    "icon": "icon.png",
    "sidebarIcon": "sidebar_icon.png",
    "source": {
        "type": "github",
        "repo": "NGGTLightKeeper/ASLM-Chat"
    },
    "update": {
        "mode": "release",
        "channel": "release",
        "branch": "main",
        "preserve": [
            "Data/downloads_bridge_cache",
            "Data/venvs",
            "Settings/settings.json",
            "Skills",
            "MCP/mcp.json",
            "Tools/mcp-web-search/models",
            "db.sqlite3"
        ],
        "runFirstRunAfterUpdate": true
    },
    "dependencies": {
        "engines": [
            {
                "id": "python-runtime",
                "libraries": [
                    "virtualenv"
                ]
            },
            {
                "id": "ollama-service"
            }
        ]
    },
    "commands": {
        "firstRun": [
            {
                "name": "首次執行設定",
                "description": "產生 settings.json 並套用資料庫遷移",
                "engine": "python-runtime",
                "exec": "main.py first_run"
            }
        ],
        "run": [
            {
                "name": "UI 伺服器",
                "description": "啟動 Django 開發伺服器",
                "engine": "python-runtime",
                "exec": "main.py runserver"
            },
            {
                "name": "Ollama 執行階段",
                "description": "在專用主控台工作階段中啟動受管理的 Ollama 服務",
                "engine": "python-runtime",
                "exec": "main.py ollama_runtime --log"
            }
        ]
    },
    "settings": [
        {
            "key": "ui-port",
            "name": "UI 伺服器連接埠",
            "description": "UI 伺服器監聽的連接埠",
            "type": "port",
            "default": 20000,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ui-port",
            "setExec": "main.py set_setting --key ui-port --value {value}"
        },
        {
            "key": "api-port",
            "name": "API 伺服器連接埠",
            "description": "API 伺服器監聽的連接埠",
            "type": "port",
            "default": 20001,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key api-port",
            "setExec": "main.py set_setting --key api-port --value {value}"
        },
        {
            "key": "aslm-host-theme",
            "name": "ASLM 主機主題",
            "description": "來自 ASLM 應用程式的主題快照；在每次模組啟動時套用。僅由 ASLM 管理。",
            "type": "theme",
            "engine": "python-runtime",
            "setExec": "main.py apply_aslm_host_theme --file {value}"
        },
        {
            "key": "aslm-host-locale",
            "name": "ASLM 主機語言",
            "description": "來自 ASLM 應用程式的語言快照；在每次模組啟動時套用。僅由 ASLM 管理。",
            "type": "locale",
            "engine": "python-runtime",
            "setExec": "main.py apply_aslm_locale --file {value}"
        },
        {
            "key": "console_log_level",
            "name": "主控台記錄層級",
            "description": "ASLM-Chat 輸出至 ASLM 主控台的執行階段詳細資訊量",
            "type": "select",
            "default": "debug",
            "allowedValues": [
                "basic",
                "debug",
                "trace"
            ],
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key console_log_level",
            "setExec": "main.py set_setting --key console_log_level --value {value}"
        },
        {
            "key": "llm-engine",
            "name": "使用中 LLM 引擎",
            "description": "在聊天介面中用於生成的引擎",
            "type": "select",
            "default": "ollama-service",
            "allowedValues": [
                "ollama-service",
                "lms",
                "openai",
                "google-genai"
            ],
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key llm-engine",
            "setExec": "main.py set_setting --key llm-engine --value {value}",
            "value": "ollama-service"
        },
        {
            "key": "ollama-service",
            "name": "Ollama",
            "description": "是否已安裝 Ollama 推論服務",
            "type": "engine",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service",
            "setExec": "main.py set_setting --key ollama-service --value {value}"
        },
        {
            "key": "ollama-service_path",
            "name": "Ollama 路徑",
            "description": "Ollama 可執行檔的路徑",
            "type": "path",
            "default": null,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_path",
            "setExec": "main.py set_setting --key ollama-service_path --value {value}"
        },
        {
            "key": "ollama-service_data",
            "name": "Ollama 資料",
            "description": "Ollama 資料目錄的路徑",
            "type": "data",
            "default": null,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_data",
            "setExec": "main.py set_setting --key ollama-service_data --value {value}"
        },
        {
            "key": "ollama-service_models",
            "name": "Ollama 模型",
            "description": "Ollama 模型目錄的路徑",
            "type": "models",
            "default": null,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_models",
            "setExec": "main.py set_setting --key ollama-service_models --value {value}"
        },
        {
            "key": "ollama-service_port",
            "name": "Ollama 連接埠",
            "description": "本機 Ollama 服務監聽的連接埠",
            "type": "port",
            "default": 20003,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key ollama-service_port",
            "setExec": "main.py set_setting --key ollama-service_port --value {value}"
        },
        {
            "key": "lms",
            "name": "LM Studio",
            "description": "LM Studio 整合是否可用",
            "type": "engine",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key lms",
            "setExec": "main.py set_setting --key lms --value {value}"
        },
        {
            "key": "lms_url",
            "name": "LM Studio 位址",
            "description": "LM Studio 伺服器 API 的基礎位址",
            "type": "string",
            "default": "127.0.0.1:1234",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key lms_url",
            "setExec": "main.py set_setting --key lms_url --value {value}",
            "value": "127.0.0.1:1234"
        },
        {
            "key": "openai",
            "name": "OpenAI 相容 API",
            "description": "OpenAI 相容 API 端點是否可用",
            "type": "engine",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key openai",
            "setExec": "main.py set_setting --key openai --value {value}"
        },
        {
            "key": "openai_url",
            "name": "OpenAI 相容位址",
            "description": "OpenAI 相容 API 端點的基礎 URL",
            "type": "string",
            "default": "127.0.0.1:1234/v1",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key openai_url",
            "setExec": "main.py set_setting --key openai_url --value {value}",
            "value": "127.0.0.1:1234/v1"
        },
        {
            "key": "openai_api_key",
            "name": "OpenAI 相容 API 金鑰",
            "description": "用於受保護端點的選用 API 金鑰",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key openai_api_key",
            "setExec": "main.py set_setting --key openai_api_key --value {value}"
        },
        {
            "key": "google-genai",
            "name": "Google GenAI",
            "description": "Google GenAI 整合是否可用",
            "type": "engine",
            "default": true,
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key google-genai",
            "setExec": "main.py set_setting --key google-genai --value {value}"
        },
        {
            "key": "google_genai_url",
            "name": "Google GenAI 位址",
            "description": "Google GenAI Gemini API 端點的基礎 URL",
            "type": "string",
            "default": "generativelanguage.googleapis.com",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key google_genai_url",
            "setExec": "main.py set_setting --key google_genai_url --value {value}"
        },
        {
            "key": "google_genai_api_key",
            "name": "Google GenAI API 金鑰",
            "description": "用於 Google GenAI Gemini API 請求的 API 金鑰",
            "type": "password",
            "default": "",
            "engine": "python-runtime",
            "getExec": "main.py get_setting --key google_genai_api_key",
            "setExec": "main.py set_setting --key google_genai_api_key --value {value}"
        }
    ],
    "downloadsBridge": {
        "protocolVersion": 1,
        "engine": "python-runtime",
        "entryPoint": "main.py downloads_bridge",
        "operations": [
            "list_categories",
            "list_items",
            "describe_item",
            "resolve_install",
            "resolve_uninstall"
        ],
        "categories": [
            {
                "id": "ollama-library",
                "title": "Ollama 模型",
                "description": "官方 Ollama 程式庫中發佈的模型。",
                "groupKey": "ollama-models",
                "targetRef": "ollama_models",
                "sortOrder": 10
            }
        ],
        "targets": {
            "ollama_models": {
                "root": "Models",
                "relative": "ollama-service",
                "description": "Managed Ollama model storage inside ASLM."
            }
        }
    },
    "moduleInterop": {
        "protocolVersion": 1,
        "client": {
            "enabled": true
        }
    },
    "status": {
        "installed": false,
        "enabled": false,
        "firstRunCompleted": false
    }
}
