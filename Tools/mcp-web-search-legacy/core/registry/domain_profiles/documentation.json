{
  "profile": "documentation",
  "description": "Official product, language, and platform documentation sites.",
  "defaults": {
    "base_weight": 1.0,
    "tier": "moderate",
    "method": "http",
    "rps": 1.0,
    "burst": 3
  },
  "domains": [
    {
      "pattern": "cursor.com",
      "tier": "friendly",
      "method": "http",
      "rps": 1.5,
      "burst": 4,
      "response_time_ms": 1200,
      "parsing_mode": "nextjs_rsc",
      "notes": "Docs pages embed useful Next.js RSC payloads in SSR HTML. Prefer direct RSC extraction on plain HTTP before generic HTML normalization or browser fallback.",
      "class_weights": {
        "documentation": 1.45,
        "technical": 1.05
      },
      "hard_demotions": {
        "forum": 0.5,
        "troubleshooting": 0.55
      },
      "source_types": [
        "docs"
      ]
    },
    {
      "pattern": "developer.mozilla.org",
      "tier": "friendly",
      "method": "http",
      "rps": 2.0,
      "burst": 5,
      "response_time_ms": 380,
      "notes": "MDN Web Docs; reliable for web platform references.",
      "class_weights": {
        "documentation": 1.4,
        "technical": 0.95
      },
      "hard_demotions": {
        "forum": 0.5,
        "troubleshooting": 0.55
      },
      "path_weights": [
        {
          "path_prefix": "/en-US/docs/",
          "class_weights": {
            "documentation": 1.5
          }
        }
      ],
      "source_types": [
        "docs"
      ]
    },
    {
      "pattern": "docker.com",
      "aliases": [
        "docs.docker.com"
      ],
      "tier": "friendly",
      "method": "http",
      "rps": 2.0,
      "burst": 4,
      "response_time_ms": 3000,
      "notes": "Official Docker documentation. Root may redirect; specific doc pages at docs.docker.com work fine.",
      "class_weights": {
        "documentation": 1.4,
        "technical": 0.95
      },
      "hard_demotions": {
        "forum": 0.5,
        "troubleshooting": 0.55
      },
      "path_weights": [
        {
          "path_prefix": "/",
          "class_weights": {
            "documentation": 1.35
          },
          "notes": "Prefer docs.docker.com alias paths"
        }
      ],
      "source_types": [
        "docs"
      ]
    },
    {
      "pattern": "docs.anthropic.com",
      "tier": "friendly",
      "method": "http",
      "rps": 2.0,
      "burst": 5,
      "response_time_ms": 1330,
      "notes": "Official Anthropic/Claude API documentation. Well-structured, no bot protection.",
      "class_weights": {
        "documentation": 1.4,
        "technical": 0.95,
        "academic": 0.7
      },
      "hard_demotions": {
        "forum": 0.5,
        "troubleshooting": 0.55
      },
      "source_types": [
        "docs",
        "api"
      ]
    },
    {
      "pattern": "docs.python.org",
      "tier": "friendly",
      "method": "http",
      "rps": 3.0,
      "burst": 5,
      "response_time_ms": 290,
