{
  "profile": "common_infra",
  "description": "CDNs, static asset hosts, package registries, and cross-class public APIs.",
  "defaults": {
    "base_weight": 1.0,
    "tier": "friendly",
    "method": "http",
    "rps": 2.0,
    "burst": 4,
    "class_weights": {
      "technical": 1.25,
      "documentation": 1.15,
      "academic": 1.05,
      "general": 1.0
    },
    "hard_demotions": {
      "shopping": 0.22,
      "entertainment": 0.35,
      "local": 0.4
    },
    "source_types": [
      "cdn",
      "api",
      "registry"
    ]
  },
  "domains": [
    {
      "pattern": "github.com",
      "tier": "friendly",
      "method": "http",
      "rps": 2.0,
      "burst": 5,
      "response_time_ms": 930,
      "json_api_hint": "GitHub REST/GraphQL APIs",
      "notes": "Excellent for source code, issues, releases, and README extraction.",
      "topics": [
        "tech"
      ],
      "class_weights": {
        "technical": 1.35,
        "documentation": 1.1,
        "academic": 0.95,
        "general": 0.9
      },
      "hard_demotions": {
        "shopping": 0.2,
        "entertainment": 0.3
      },
      "source_types": [
        "repository",
        "api"
      ]
    },
    {
      "pattern": "raw.githubusercontent.com",
      "aliases": [
        "githubusercontent.com"
      ],
      "tier": "friendly",
      "method": "http",
      "rps": 3.0,
      "burst": 8,
      "notes": "Static raw file hosting for repos; prefer direct raw URLs over HTML repo pages when fetching blobs.",
      "class_weights": {
        "technical": 1.3,
        "documentation": 1.2
      },
      "hard_demotions": {
        "shopping": 0.18
      },
      "source_types": [
        "cdn",
        "static_host"
      ]
    },
    {
      "pattern": "pypi.org",
      "tier": "friendly",
      "method": "json_api",
      "rps": 2.0,
      "burst": 4,
      "response_time_ms": 450,
      "json_api_hint": "https://pypi.org/pypi/<project>/json",
      "notes": "Use JSON endpoints for package metadata and release history.",
      "topics": [
        "tech"
      ],
      "class_weights": {
        "technical": 1.35,
        "documentation": 1.15
      },
      "hard_demotions": {
        "shopping": 0.2
      },
      "source_types": [
        "api",
        "registry"
      ]
    },
    {
      "pattern": "npmjs.com",
      "aliases": [
        "registry.npmjs.org"
      ],
      "tier": "hardened",
      "method": "json_api",
      "rps": 2.0,
      "burst": 4,
      "response_time_ms": 570,
      "json_api_hint": "https://registry.npmjs.org/<package>",
      "waf": "bot_management",
      "notes": "Web pages block automated access. Use npm registry API instead — fully public, no auth needed.",
      "topics": [
        "tech"
      ],
      "try_preview_bot": true,
      "class_weights": {
        "technical": 1.35,
        "documentation": 1.1
      },
      "hard_demotions": {
        "shopping": 0.2,
        "entertainment": 0.32
      },
      "source_types": [
        "api",
        "registry"
      ]
    },
    {
      "pattern": "wikidata.org",
      "tier": "friendly",
      "method": "json_api",
      "rps": 3.0,
      "burst": 6,
      "response_time_ms": 1670,
      "json_api_hint": "https://www.wikidata.org/w/api.php?action=wbsearchentities&search=<q>&language=en&format=json",
      "notes": "Structured knowledge graph companion to Wikipedia.",
      "topics": [
        "general",
        "academic",
        "tech"
      ],
      "class_weights": {
        "academic": 1.3,
        "general": 1.1,
        "technical": 0.95
      },
      "hard_demotions": {
        "shopping": 0.25
      },
      "source_types": [
        "api",
        "encyclopedia"
      ]
    },
    {
      "pattern": "cdn.jsdelivr.net",
      "tier": "friendly",
      "method": "http",
      "rps": 4.0,
      "burst": 10,
      "notes": "Public CDN for npm/GitHub packages and libraries; static asset delivery only.",
      "class_weights": {
        "technical": 1.25,
        "documentation": 1.15
      },
      "hard_demotions": {
        "shopping": 0.15
      },
      "source_types": [
        "cdn",
        "static_host"
      ]
    },
    {
      "pattern": "unpkg.com",
      "tier": "friendly",
      "method": "http",
      "rps": 3.0,
      "burst": 8,
      "notes": "npm CDN mirror for browser package files.",
      "class_weights": {
        "technical": 1.25,
        "documentation": 1.1
      },
      "hard_demotions": {
        "shopping": 0.15
      },
      "source_types": [
        "cdn",
        "static_host"
      ]
    },
    {
      "pattern": "fonts.googleapis.com",
      "aliases": [
        "fonts.gstatic.com"
      ],
      "tier": "friendly",
      "method": "http",
      "rps": 3.0,
      "burst": 8,
      "notes": "Google Fonts CSS and static font assets; not primary content sources.",
      "class_weights": {
        "technical": 1.05,
        "documentation": 1.0
      },
      "hard_demotions": {
        "shopping": 0.12,
        "journalistic": 0.2,
        "forum": 0.2
      },
      "source_types": [
        "cdn",
        "static_host"
      ]
    },
    {
      "pattern": "gstatic.com",
      "tier": "friendly",
      "method": "http",
      "rps": 3.0,
      "burst": 8,
      "notes": "Google static asset CDN (images, scripts, fonts).",
      "class_weights": {
        "technical": 1.05
      },
      "hard_demotions": {
        "shopping": 0.12,
        "journalistic": 0.2
      },
      "source_types": [
        "cdn",
        "static_host"
      ]
    }
  ]
}
