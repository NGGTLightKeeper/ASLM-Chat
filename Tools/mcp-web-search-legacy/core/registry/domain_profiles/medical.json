{
  "profile": "medical",
  "description": "Clinical and biomedical literature indexes and health-science databases.",
  "defaults": {
    "base_weight": 1.0,
    "tier": "moderate",
    "method": "http",
    "rps": 1.0,
    "burst": 3
  },
  "domains": [
    {
      "pattern": "pubmed.ncbi.nlm.nih.gov",
      "tier": "friendly",
      "method": "json_api",
      "rps": 2.0,
      "burst": 4,
      "response_time_ms": 940,
