            "fulltext",
            "article"
          ]
        },
        {
          "path_prefix": "/books/",
          "class_weights": {
            "medical": 1.25,
            "academic": 1.05
          },
          "source_types": [
            "book",
            "reference"
          ]
        }
      ],
      "source_types": [
        "biomedical",
        "reference"
      ]
    }
  ]
