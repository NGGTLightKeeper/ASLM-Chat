      "notes": "NCBI E-utilities are fully public without API key (3 req/sec unauthenticated).",
      "class_weights": {
        "medical": 1.52,
        "academic": 1.08
      },
      "path_weights": [
        {
          "path_prefix": "/",
          "class_weights": {
            "medical": 1.52,
            "academic": 1.05
          },
          "source_types": [
            "journal",
            "api"
          ]
        }
      ],
      "source_types": [
        "api",
        "journal"
      ]
    },
    {
      "pattern": "ncbi.nlm.nih.gov",
      "tier": "friendly",
      "method": "http",
      "rps": 1.0,
      "burst": 3,
      "response_time_ms": 940,
