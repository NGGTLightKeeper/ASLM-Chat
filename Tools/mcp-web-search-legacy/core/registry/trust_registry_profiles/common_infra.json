{
  "profile": "common_infra",
  "description": "Code hosting, package registries, CDNs, and static asset infrastructure (tier A/B).",
  "defaults": {
    "tier": "B",
    "cat": "infra"
  },
  "domains": [
    {
      "pattern": "github.com",
      "tier": "B",
      "cat": "code",
      "aliases": [],
      "class_affinity": {
        "technical": 1.0,
        "documentation": 0.92,
        "forum": 0.55,
        "general": 0.5
      },
      "notes": "Primary source repo host; HTML pages are secondary to API/raw URLs."
    },
    {
      "pattern": "gitlab.com",
      "tier": "B",
      "cat": "code",
      "aliases": [],
      "class_affinity": {
        "technical": 1.0,
        "documentation": 0.88,
        "forum": 0.5
      },
      "notes": "Source hosting and CI metadata; same caveats as GitHub HTML."
    },
    {
      "pattern": "raw.githubusercontent.com",
      "tier": "B",
      "cat": "infra",
      "aliases": [
        "githubusercontent.com"
      ],
      "class_affinity": {
        "technical": 1.0,
        "documentation": 0.95
      },
      "notes": "Static raw blobs for repositories; prefer over repo HTML for file fetches."
    },
    {
      "pattern": "pypi.org",
      "tier": "B",
      "cat": "docs",
      "aliases": [],
      "class_affinity": {
        "technical": 1.0,
        "documentation": 0.9
      },
      "notes": "Use /pypi/<project>/json for package metadata; web UI is secondary."
    },
    {
      "pattern": "pkg.go.dev",
      "tier": "A",
      "cat": "docs",
      "aliases": [],
      "class_affinity": {
        "technical": 1.0,
        "documentation": 0.95
      },
      "notes": "Official Go package documentation and module index."
    },
    {
      "pattern": "npmjs.com",
      "tier": "B",
      "cat": "infra",
      "aliases": [
        "registry.npmjs.org"
      ],
      "class_affinity": {
        "technical": 1.0,
        "documentation": 0.88
      },
      "notes": "npm registry and package pages; prefer registry.npmjs.org JSON API over HTML."
    },
    {
      "pattern": "cdn.jsdelivr.net",
      "tier": "B",
      "cat": "infra",
      "aliases": [],
      "class_affinity": {
        "technical": 0.95,
        "documentation": 0.85
      },
      "notes": "Public CDN for npm/GitHub assets; static delivery only, not narrative content."
    },
    {
      "pattern": "unpkg.com",
      "tier": "B",
      "cat": "infra",
      "aliases": [],
      "class_affinity": {
        "technical": 0.95,
        "documentation": 0.85
      },
      "notes": "npm CDN mirror for browser package files."
    },
    {
      "pattern": "fonts.googleapis.com",
      "tier": "B",
      "cat": "infra",
      "aliases": [
        "fonts.gstatic.com"
      ],
      "class_affinity": {
        "technical": 0.7,
        "documentation": 0.65
      },
      "notes": "Google Fonts CSS endpoint; static assets, not primary sources."
    },
    {
      "pattern": "gstatic.com",
      "tier": "B",
      "cat": "infra",
      "aliases": [],
      "class_affinity": {
        "technical": 0.7
      },
      "notes": "Google static asset CDN (scripts, images, fonts)."
    },
    {
      "pattern": "wikidata.org",
      "tier": "B",
      "cat": "infra",
      "aliases": [],
      "class_affinity": {
        "academic": 0.85,
        "general": 0.75,
        "technical": 0.7
      },
      "notes": "Structured knowledge API; companion to Wikipedia, not a prose source."
    },
    {
      "pattern": "huggingface.co",
      "tier": "B",
      "cat": "engineering",
      "aliases": [],
      "class_affinity": {
        "technical": 0.95,
        "academic": 0.8,
        "documentation": 0.75
      },
      "notes": "Model and dataset hub; treat like a package registry for ML artifacts."
    }
  ]
}
