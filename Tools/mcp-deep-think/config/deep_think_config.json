{
  "llm": {
    "base_url": "http://localhost:1234/v1/chat/completions",
    "model": "local-model",
    "max_concurrent_requests": 2,
    "timeout_seconds": 120.0,
    "selector_enabled": true,
    "selector_temperature": 0.2,
    "selector_max_tokens": 500,
    "synthesis_temperature": 0.25,
    "synthesis_max_tokens": 2200
  },
  "search": {
    "language": "en-US",
    "results_limit": 5,
    "cache_ttl_seconds": 300,
    "max_concurrent_requests": 3,
    "enable_lightweight_read": true,
    "lightweight_read_top_results": 1,
    "lightweight_read_char_budget": 2000
  },
  "sandbox": {
    "enabled": true,
    "timeout_seconds": 20,
    "auto_confirm": true,
    "max_output_chars": 12000,
    "container_name": "deep-think-sandbox",
    "image": "dima1312313/deep-think-sandbox:latest"
  },
  "limits": {
    "max_active_agents": 4,
    "max_iterations_per_agent": 4,
    "task_timeout_seconds": 600.0,
    "per_agent_timeout_seconds": 240.0,
    "max_reflect_without_tool": 2
  },
  "profiles": {
    "quick": {
      "max_active_agents": 3,
      "max_iterations_per_agent": 2,
      "search_results_limit": 4,
      "sandbox_timeout_seconds": 12,
      "synthesis_max_tokens": 1400,
      "per_agent_timeout_seconds": 120.0
    },
    "balanced": {
      "max_active_agents": 4,
      "max_iterations_per_agent": 4,
      "search_results_limit": 5,
      "sandbox_timeout_seconds": 20,
      "synthesis_max_tokens": 2200,
      "per_agent_timeout_seconds": 240.0
    },
    "research": {
      "max_active_agents": 4,
      "max_iterations_per_agent": 4,
      "search_results_limit": 8,
      "sandbox_timeout_seconds": 30,
      "synthesis_max_tokens": 3000,
      "per_agent_timeout_seconds": 360.0
    }
  },
  "agents": {
    "fact_checker": {
      "enabled": true,
      "has_search": true,
      "has_python": true,
      "temperature": 0.1,
      "max_tokens": 2200
    },
    "secops": {
      "enabled": true,
      "has_search": true,
      "has_python": true,
      "temperature": 0.2,
      "max_tokens": 2200
    },
    "architect": {
      "enabled": true,
      "has_search": false,
      "has_python": false,
      "temperature": 0.25,
      "max_tokens": 2400
    },
    "implementer": {
      "enabled": true,
      "has_search": true,
      "has_python": true,
      "temperature": 0.2,
      "max_tokens": 2600
    },
    "performance": {
      "enabled": true,
      "has_search": true,
      "has_python": true,
      "temperature": 0.2,
      "max_tokens": 2200
    },
    "ux_ethics": {
      "enabled": true,
      "has_search": false,
      "has_python": false,
      "temperature": 0.45,
      "max_tokens": 1800
    },
    "creative": {
      "enabled": true,
      "has_search": false,
      "has_python": false,
      "temperature": 0.8,
      "max_tokens": 1800
    },
    "historian": {
      "enabled": true,
      "has_search": true,
      "has_python": false,
      "temperature": 0.3,
      "max_tokens": 2000
    }
  },
  "output": {
    "root_dir": "_out",
    "write_events_jsonl": true,
    "write_markdown": true,
    "write_json": true
  },
  "mcp": {
    "default_profile": "balanced",
    "include_raw_reports_in_full": true
  }
}
